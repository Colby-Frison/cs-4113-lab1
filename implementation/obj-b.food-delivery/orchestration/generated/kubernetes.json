                    "mountPath": "/data"
                  }
                ],
                "imagePullPolicy": "IfNotPresent",
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "test",
                      "-f",
                      "/data/run/courier-0.ready"
                    ]
                  },
                  "periodSeconds": 1
