            "automountServiceAccountToken": false,
            "initContainers": [
              {
                "name": "init",
                "image": "food-delivery:local",
                "args": [
                  "init"
                ],
                "env": [
                  {
                    "name": "FOOD_TRANSPORT",
                    "value": "grpc"
                  },
                  {
                    "name": "FOOD_LOCALHOST",
                    "value": "1"
                  },
                  {
                    "name": "FOOD_CONFIG",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "food-config",
                        "key": "config.json"
                      }
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "256Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "results",
                    "mountPath": "/data"
                  }
                ],
                "imagePullPolicy": "IfNotPresent"
              }
            ],
            "containers": [
              {
                "name": "courier-0",
                "image": "food-delivery:local",
                "args": [
