    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "food-delivery"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "food-config",
        "namespace": "food-delivery"
      },
      "data": {
        "config.json": "{\n  \"kitchen_workers\": 2,\n  \"couriers\": 3,\n  \"kitchen_capacity\": 16,\n  \"pickup_capacity\": 16,\n  \"count\": 100,\n  \"arrival_mean\": 0.04,\n  \"time_scale\": 1.0,\n  \"seed\": 1\n}"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "food-results",
        "namespace": "food-delivery"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
